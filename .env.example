NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# WHAT: Switch only the composition root; routers and services remain unchanged.
DATABASE_CLIENT=prisma
DATABASE_URL=postgresql://app:app@localhost:5432/learning
# WHAT: `directConnection` makes the single exposed Docker member usable for local labs.
MONGODB_URL=mongodb://127.0.0.1:27017/learning?replicaSet=rs0&directConnection=true
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:4200
# Set this in shared environments. Leave empty for the local lessons.
API_KEY=
AWS_REGION=eu-central-1
S3_UPLOAD_BUCKET=

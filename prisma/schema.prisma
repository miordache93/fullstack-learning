// WHAT: Generate a typed ESM client inside the backend library that owns persistence.
generator client {
  provider            = "prisma-client"
  output              = "../libs/backend/core/src/generated/prisma"
  moduleFormat        = "esm"
  // WHY: Keep compiled Node ESM imports resolvable when backend-core is used unbundled.
  importFileExtension = "js"
}

// BOUNDARY: Declare PostgreSQL semantics while prisma.config.ts supplies credentials.
datasource db {
  provider = "postgresql"
}

// WHAT: Map the domain-friendly Prisma model to the existing snake_case SQL table.
model Task {
  // WHY: Let PostgreSQL generate UUIDs so every database writer gets the same policy.
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String      @db.VarChar(200)
  description String?
  done        Boolean     @default(false)
  priority    String      @default("medium") @db.VarChar(10)
  // WHY: Increment this token to reject a write based on a stale read.
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  // WHAT: Express ownership so Prisma can perform relational and nested operations.
  events      TaskEvent[]

  // WHY: Match the newest-first list access path used by the API.
  @@index([createdAt(sort: Desc), id], map: "idx_tasks_created_at")
  @@map("tasks")
}

// WHAT: Preserve state-change evidence separately from the current task projection.
model TaskEvent {
  id        BigInt   @id @default(autoincrement())
  taskId    String   @map("task_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(50)
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // INVARIANT: Deleting a task also deletes events that cannot exist without it.
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt(sort: Desc)], map: "idx_task_events_task_created")
  @@map("task_events")
}

// WHAT: Model durable background work even though the advanced claim uses raw SQL.
model JobQueue {
  id          BigInt    @id @default(autoincrement())
  payload     Json
  status      String    @default("pending") @db.VarChar(20)
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy    String?   @map("locked_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("job_queue")
}
